PORT=9000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bomiora
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me
IMAGE_BASE_URL=https://bomiora.kr
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# 네이버 소셜 로그인 (웹 OAuth + Android SDK 동일 키)
# 네이버 개발자센터 → API 설정 → Callback URL 에 NAVER_CALLBACK_URL 등록 필수
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=https://bomiora.net/api/auth/naver/callback
NAVER_OAUTH_TTL_MS=600000

# 카카오 소셜 로그인 (웹 OAuth — 네이버와 동일 전체 페이지 리다이렉트)
# REST API 키는 주소검색 KAKAO_REST_API_KEY 와 동일 키 사용 가능
# 카카오 개발자센터 → 앱 설정 → Redirect URI 에 KAKAO_CALLBACK_URL 등록 필수
KAKAO_CALLBACK_URL=https://bomiora.net/api/auth/kakao/callback
KAKAO_CLIENT_SECRET=
KAKAO_OAUTH_TTL_MS=600000

# Apple 로그인 (iOS 네이티브 identityToken 검증 + Android/웹 callback)
# Apple Developer → Identifiers → App ID에 Sign in with Apple
# Services ID(안드로이드/웹) Redirect URL에 APPLE_CALLBACK_URL 등록
APPLE_BUNDLE_ID=com.bomiora.app
APPLE_SERVICE_ID=com.bomiora.app.signin
APPLE_CALLBACK_URL=https://bomiora.net/api/auth/apple/callback
APPLE_ANDROID_PACKAGE=com.bomiora.app

KCP_TEST_MODE=false
# 본인인증(KCP cert) 전용 site code (쇼핑 결제용 KCP_PAY_SITE_CD 와 다를 수 있음)
KCP_SITE_CD=
KCP_CERT_URL=https://cert.kcp.co.kr/kcp_cert/cert_view.jsp
KCP_WEB_SITEID=
KCP_ENC_KEY=
KCP_HOME_DIR=
KCP_CTCLI_PATH=
KCP_CALLBACK_URL=https://bomiora.net/api/auth/kcp/callback
KCP_CERT_OTP_USE=Y
KCP_CERT_ENC_USE=Y
KCP_CERT_ENC_USE_EXT=N
KCP_ORDER_PREFIX=KCP
KCP_RESULT_TTL_MS=600000

KCP_PAY_TEST_MODE=true
# 쇼핑몰 결제(PayPlus) — KCP 계약 site_cd (예: SRA9A). 본인인증용 KCP_SITE_CD 와 혼동하지 말 것.
KCP_PAY_SITE_CD=
# 위 site_cd 와 쌍인 site key (KCP 관리자/계약서)
KCP_PAY_SITE_KEY=
KCP_PAY_SITE_NAME=BOMIORA
KCP_PAY_JS_URL=https://testpay.kcp.co.kr/plugin/payplus_web.jsp
KCP_PAY_CALLBACK_URL=https://bomiora.net/api/kcp-pay/callback
KCP_PAY_DEV_BYPASS=false
# Node에서 spawn php ENOENT 방지 — php.exe 전체 경로 (또는 PATH에 php 등록)
PHP_PATH=
# kcp_approval_bridge: pp_ax_hub_lib.php 가 있는 폴더 (…/bin 이 아님)
KCP_PAY_HOME_DIR=

ADDRESS_PROVIDER=kakao
KAKAO_REST_API_KEY=
KAKAO_ADDRESS_SEARCH_URL=https://dapi.kakao.com/v2/local/search/address.json
ADDRESS_SEARCH_MIN_QUERY_LENGTH=2
ADDRESS_SEARCH_MAX_PAGE_SIZE=10
ADDRESS_SEARCH_CACHE_TTL_MS=300000
ADDRESS_SEARCH_RATE_LIMIT_WINDOW_MS=1000
ADDRESS_SEARCH_RATE_LIMIT_MAX_REQUESTS=5

# ---------------------------------------------------------------------------
# Bizmsg 알림톡 OTP (소유(휴대폰) 인증) — /api/auth/otp/*
# - Flutter 앱에서는 Bizmsg를 직접 호출하지 않고, 백엔드가 발송/검증을 담당합니다.
# - Bizmsg "기본형 템플릿"인 경우 title 필드를 보내면 K109가 발생하므로 백엔드에서 title을 전송하지 않습니다.
# - msg 본문은 카카오 승인 템플릿과 완전 동일해야 하며, 변수(OTP) 자리만 치환됩니다.
# ---------------------------------------------------------------------------

# Bizmsg 계정명: API 요청 헤더 `userid`로 전송됩니다.
BOMIORA_OTP_BIZM_USERID=bomioramall01

# 발신프로필 키(senderKey): 카카오 채널에 연결된 프로필 키
# 예) 48f0... (실제 senderKey를 넣으세요)
BOMIORA_OTP_BIZM_PROFILE=

# 승인된 알림톡 템플릿 코드
# 예) bomiora_pwfind_otp
BOMIORA_OTP_TMPL_ID=bomiora_pwfind_otp

# 선택: OTP 유효시간(초). 기본값 180초
# (PHP와 동일 키) BOMIORA_OTP_EXPIRE_SEC
BOMIORA_OTP_EXPIRE_SEC=180

# 선택: OTP 검증 실패 최대 허용 횟수. 기본값 5회 (초과 시 verified_yn='X'로 잠금)
BOMIORA_OTP_MAX_TRY=5

# Firebase Cloud Messaging (Admin SDK — 푸시 발송용)
# config/firebase-bomiora.json 경로 (기본: 프로젝트/config/firebase-bomiora.json)
FIREBASE_CREDENTIAL_PATH=
# 개발 서버에서 POST /api/user/fcm-test 허용 (production에서는 NODE_ENV=production 이면 기본 차단)
FCM_TEST_ENABLED=true
# true 이면 앱 로그인 → FCM 토큰 등록 시 자동으로 테스트 푸시 1통 발송
FCM_TEST_ON_REGISTER=false
# 스케줄러 공통 시각 (기본 매일 KST 08:00). 잡별 값이 있으면 그쪽이 우선.
DAILY_JOB_HOUR=8
DAILY_JOB_MINUTE=0
COUPON_EXPIRY_PUSH_HOUR=8
COUPON_EXPIRY_PUSH_MINUTE=0
REVIEW_REQUEST_PUSH_HOUR=8
REVIEW_REQUEST_PUSH_MINUTE=0
AUTO_CONFIRM_PUSH_HOUR=8
AUTO_CONFIRM_PUSH_MINUTE=0
# 리뷰 요청: 배송중 후 경과 분. 테스트 30 / 운영 3일=4320
REVIEW_REQUEST_DELAY_MINUTES=30
# 리뷰 푸시 대상 최대 경과(분). 이보다 오래된 배송중은 발송 없이 sent 처리(백로그 폭주 방지)
REVIEW_REQUEST_MAX_AGE_MINUTES=2880

# PHP 관리자 등 내부 시스템 → POST /api/internal/notify 인증 키
INTERNAL_NOTIFY_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# 앱 → Cafe24 /adm/ 일회용 자동로그인
# Cafe24 adm/newProject/app_auto_login.php 의 ADMIN_AUTO_LOGIN_SECRET 과 동일해야 함
ADMIN_AUTO_LOGIN_SECRET=CHANGE_ME_ADMIN_AUTO_LOGIN_SECRET
ADMIN_AUTO_LOGIN_TTL_MS=600000
ADMIN_WEB_BASE=https://bomiora0.mycafe24.com

# ---------------------------------------------------------------------------
# 사용자 업로드 이미지 → Cafe24 data/ 미러 (관리자 PHP·정적 URL)
# Cafe24: app_image_mirror.php + image_mirror_config.php 배포 필요
# ---------------------------------------------------------------------------
IMAGE_MIRROR_URL=https://bomiora0.mycafe24.com/app_image_mirror.php
IMAGE_MIRROR_SECRET=CHANGE_ME_SAME_AS_INTERNAL_NOTIFY_SECRET
CAFE24_IMAGE_PUBLIC_BASE=https://bomiora0.mycafe24.com/data
